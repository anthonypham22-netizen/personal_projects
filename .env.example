# Copy this file to .env.local for local development. Server deployments should
# use the staging or production values documented in docs/HOSTING.md.
APP_ENV=development
APP_URL=http://localhost:3000
DATA_DIR=./data/dev
# Demo accounts and fictional data. Allowed in development and staging only;
# application startup fails if this is true in production.
ALLOW_DEMO=true
# Staging and production run behind HTTPS and must set this to true.
COOKIE_SECURE=false
# Disable public registration for an invitation-only pilot if desired.
ALLOW_REGISTRATION=true
# Staging always emits noindex. In production this flag remains false until the
# public content and privacy review are complete.
PUBLIC_NETWORK_INDEXING_ENABLED=false
# Minimum persisted project-to-deal score required for Qualified Discovery.
QUALIFIED_DISCOVERY_MIN_SCORE=70
# Minimum internal buyer review state required for Qualified Discovery.
# Allowed values: unverified, email_verified, firm_verified, capital_reviewed, verified_acquirer.
QUALIFIED_DISCOVERY_MIN_VERIFICATION_STATUS=firm_verified
# Development/demo only. Production intentionally fails closed until an
# established electronic-signature provider adapter is configured in code.
ELECTRONIC_SIGNATURE_PROVIDER=development
# Replace for shared development or staging; never commit the real secret.
ELECTRONIC_SIGNATURE_WEBHOOK_SECRET=replace-with-a-random-development-secret
# Local demo reviews stay on this machine. Production should use only an
# approved provider after privacy, retention, residency and contract review.
TEASER_SAFETY_PROVIDER=development
# For TEASER_SAFETY_PROVIDER=openai, both values are required server-side.
# OPENAI_API_KEY=
# OPENAI_TEASER_SAFETY_MODEL=
